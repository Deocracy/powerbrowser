--- a/toolkit/components/extensions/ProxyChannelFilter.sys.mjs
+++ b/toolkit/components/extensions/ProxyChannelFilter.sys.mjs
@@ -6,6 +6,43 @@ import { XPCOMUtils } from "resource://gre/modules/XPCOMUtils.sys.mjs";
 
 import { ExtensionUtils } from "resource://gre/modules/ExtensionUtils.sys.mjs";
 
+// An embedder lists origins whose browserless loads (its own service and
+// shared workers) are hidden from extension network observers, in a
+// chrome-set pref of comma-separated origins. "scheme://*.host:port" matches
+// every subdomain of host:port, for an embedder that mints one per frame.
+function isHiddenOrigin(principal) {
+  if (!principal?.isContentPrincipal) {
+    return false;
+  }
+  let origin = principal.originNoSuffix;
+  return Services.prefs
+    .getStringPref("extensions.webRequest.hiddenOrigins", "")
+    .split(",")
+    .some(entry => {
+      let wild = /^([a-z]+:\/\/)\*(\..+)$/.exec(entry);
+      return wild
+        ? origin.startsWith(wild[1]) && origin.endsWith(wild[2])
+        : entry === origin;
+    });
+}
+
+// An embedder marks a top-level browser that must stay invisible to extension
+// network observers (its own UI frame) with the extensionnetworkhidden
+// attribute. No webRequest listener, declarativeNetRequest rule or proxy
+// filter sees a channel of that browser or of any frame inside it. A channel
+// with no browser is hidden when its loading principal (a worker's own) is on
+// the embedder's hidden origins.
+function isHiddenChannel(wrapper) {
+  let browser = wrapper.browserElement;
+  if (browser) {
+    return browser.hasAttribute("extensionnetworkhidden");
+  }
+  let { loadInfo } = wrapper;
+  return isHiddenOrigin(
+    loadInfo?.loadingPrincipal ?? loadInfo?.triggeringPrincipal
+  );
+}
