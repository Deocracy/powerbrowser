{
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "Preferences": {
      "browser.crashReports.unsubmittedCheck.autoSubmit2": {
        "Value": false,
        "Status": "locked"
      }
    },
    "ExtensionSettings": {},
    "SearchEngines": {
      "Add": [
        {
          "Name": "DuckDuckGo Lite",
          "URLTemplate": "https://lite.duckduckgo.com/lite/?q={searchTerms}",
          "SuggestURLTemplate": "https://ac.duckduckgo.com/ac/?q={searchTerms}&type=list"
        },
        {
          "Name": "Wikipedia",
          "URLTemplate": "https://en.wikipedia.org/wiki/Special:Search?search={searchTerms}",
          "SuggestURLTemplate": "https://en.wikipedia.org/w/api.php?action=opensearch&search={searchTerms}"
        }
      ],
      "Default": "DuckDuckGo Lite"
    }
  }
}
