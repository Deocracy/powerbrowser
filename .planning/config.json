{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "phase_naming": "sequential",
  "project_code": null,
  "claude_md_path": "./CLAUDE.md",
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null,
    "allow_default_branch_commits": true
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "auto_advance": true,
    "human_verify_mode": "end-of-phase",
    "code_review": true,
    "code_review_depth": "standard",
    "pattern_mapper": true,
    "plan_bounce": true,
    "plan_bounce_passes": 3,
    "post_planning_gaps": true,
    "use_worktrees": false,
    "plan_review_convergence": true,
    "_auto_chain_active": false,
    "skip_discuss": true,
    "max_discuss_passes": 3,
    "node_repair": true,
    "node_repair_budget": 3
  },
  "plan_review": {
    "source_grounding": true
  },
  "intel": {
    "enabled": true
  },
  "mode": "balanced",
  "granularity": "standard",
  "graphify": {
    "enabled": true
  },
  "gsd_graph": {
    "enabled": true,
    "auto_update": true,
    "store_dir": ".gsd-graph",
    "report_on_sync": true,
    "communities_on_sync": false,
    "full_on_enable": true
  },
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "research": "sonnet",
    "execution": "opus",
    "verification": "sonnet",
    "completion": "sonnet"
  },
  "model_overrides": {
    "gsd-debugger": "opus",
    "gsd-code-reviewer": "opus",
    "gsd-security-auditor": "opus",
    "gsd-code-fixer": "opus",
    "gsd-roadmapper": "opus"
  }
}
