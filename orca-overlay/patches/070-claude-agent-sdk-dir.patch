+function importSdkFrom(dir: string): Promise<typeof ClaudeAgentSdk> {
+  try {
+    const entry = createRequire(join(dir, 'package.json')).resolve('@anthropic-ai/claude-agent-sdk')
+    if (dir && entry.startsWith(realpathSync(dir) + sep)) {
+      return import(pathToFileURL(entry).href)
+    }
+  } catch {}
+  const error = new Error(`Cannot find package '@anthropic-ai/claude-agent-sdk' in '${dir}'`)
+  return Promise.reject(Object.assign(error, { code: 'ERR_MODULE_NOT_FOUND' }))
